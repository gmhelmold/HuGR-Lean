{
  "name": "hugr-lean",
  "version": "0.1.0",
  "description": "Deterministic tool-output filtering for coding agents",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "smol-toml": "^1.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
